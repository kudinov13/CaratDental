# Порт backend-сервера (по умолчанию 3001)
PORT=3001

# Секретный ключ для подписи JWT/HMAC-токенов админки
# В production задайте длинную случайную строку
KARAT_SECRET=change-me-to-a-long-random-secret

# Логин и пароль администратора по умолчанию
# Если не задать ADMIN_PASSWORD, при первом запуске будет сгенерирован случайный пароль
ADMIN_LOGIN=admin
ADMIN_PASSWORD=karat2026
